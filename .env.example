# Runtime — pick one per deployment
BRAND=digital
PORT=3001                              # Optional (default 3001)
FRONTEND_URL=http://localhost:3000      # REQUIRED
CORS_ORIGINS=http://localhost:3000      # Optional (falls back to FRONTEND_URL)

# MongoDB — one database per deployment
DATABASE_URL=mongodb://127.0.0.1:27017/nexbaron-digital   # REQUIRED

# Auth
JWT_SECRET_DIGITAL=replace-with-at-least-32-random-characters   # REQUIRED
JWT_SECRET_PRINT=replace-with-at-least-32-random-characters     # REQUIRED
ADMIN_JWT_SECRET_DIGITAL=replace-with-a-different-32-character-secret   # REQUIRED (prod only)
ADMIN_JWT_SECRET_PRINT=replace-with-a-different-32-character-secret     # REQUIRED (prod only)
JWT_EXPIRES_IN_SECONDS=604800                             # Optional (default 604800)
GOOGLE_CLIENT_ID_DIGITAL=
GOOGLE_CLIENT_ID_PRINT=

# OTP
OTP_DEV_MODE=true
OTP_TTL_MS=600000                       # Optional (default 600000)
OTP_HASH_SECRET_DIGITAL=change-me-otp-hash-secret
OTP_HASH_SECRET_PRINT=change-me-otp-hash-secret
OTP_REQUEST_WINDOW_MS=900000            # Optional (default 900000)
OTP_MAX_REQUESTS_PER_WINDOW=3           # Optional (default 3)
OTP_FROM_EMAIL_DIGITAL=nexbaron.digital@gmail.com   # REQUIRED
OTP_FROM_EMAIL_PRINT=nexbaron.print@gmail.com       # REQUIRED

# Payments (Razorpay)
RAZORPAY_KEY_ID=             # REQUIRED
RAZORPAY_KEY_SECRET=         # REQUIRED
RAZORPAY_WEBHOOK_SECRET=     # REQUIRED

# Email (SMTP) — per-division credentials
SMTP_HOST=                   # Optional (email skipped if empty)
SMTP_PORT=587                # Optional (default 587)
SMTP_DIGITAL_USER=           # Optional (email skipped if empty)
SMTP_DIGITAL_PASS=
SMTP_PRINT_USER=             # Optional (email skipped if empty)
SMTP_PRINT_PASS=
SMTP_FROM_DOMAIN=nexbaron.com          # REQUIRED
INVOICE_FROM_EMAIL=nexbaron.digital@gmail.com      # REQUIRED
QUOTE_FROM_EMAIL_DIGITAL=nexbaron.digital@gmail.com # REQUIRED
QUOTE_FROM_EMAIL_PRINT=nexbaron.print@gmail.com     # REQUIRED
QUOTE_WHATSAPP_ENABLED=false
MAX_PRINT_QUANTITY=1000000   # Optional (default 1000000)

# Billing GSTIN is not an env var — set it in the business profile
# (src/features/digital/business-profile.ts AND src/features/print/business-profile.ts)
# once the registration certificate is received. Until then it is blank and the
# GSTIN line is hidden on invoices and profiles (no placeholder is ever printed).

# Chat attachments (Cloudflare R2 — presigned PUT, direct browser upload)
# One Cloudflare account + bucket PER DIVISION (separate R2 use the _DIGITAL/_PRINT suffix).
# R2_PUBLIC_URL is the bucket's public URL (r2.dev subdomain or custom domain), no trailing slash.
# Add a CORS policy to each bucket: allow the hub origin, methods PUT, headers Content-Type, expose ETag.
R2_ACCOUNT_ID_DIGITAL=
R2_ACCESS_KEY_ID_DIGITAL=
R2_ACCESS_KEY_SECRET_DIGITAL=
R2_BUCKET_DIGITAL=
R2_PUBLIC_URL_DIGITAL=
R2_ACCOUNT_ID_PRINT=
R2_ACCESS_KEY_ID_PRINT=
R2_ACCESS_KEY_SECRET_PRINT=
R2_BUCKET_PRINT=
R2_PUBLIC_URL_PRINT=
