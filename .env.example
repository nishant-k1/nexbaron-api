PORT=3001
FRONTEND_URL=http://localhost:3000

# MongoDB connection string
DATABASE_URL=mongodb://localhost:27017/nexbaron

# Auth
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN_SECONDS=604800

# OTP
# Keep true in dev: the code is returned in the API response and logged.
OTP_DEV_MODE=true
OTP_TTL_MS=600000

# Email / SMS providers (leave unset for dev)
# EMAIL_PROVIDER=smtp|resend|sendgrid
# SMS_PROVIDER=twilio|msg91
