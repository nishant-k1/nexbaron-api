# Server
BRAND=digital
PORT=3001
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://localhost:5174

# MongoDB - this deployment opens exactly one brand database.
DATABASE_URL=mongodb://127.0.0.1:27017/nexbaron-digital
# For local shared env files only, DATABASE_URL_DIGITAL or DATABASE_URL_PRINT may
# be used when DATABASE_URL is absent. The other brand is never a fallback.

# Auth
JWT_SECRET=replace-with-at-least-32-random-characters
ADMIN_JWT_SECRET=replace-with-a-different-32-character-secret
# Optional local shared-env alternatives: JWT_SECRET_DIGITAL/JWT_SECRET_PRINT
# and ADMIN_JWT_SECRET_DIGITAL/ADMIN_JWT_SECRET_PRINT.
JWT_EXPIRES_IN_SECONDS=604800
GOOGLE_CLIENT_ID=
# Optional shared-env alternative: GOOGLE_CLIENT_ID_DIGITAL/GOOGLE_CLIENT_ID_PRINT

# OTP. Production always disables devCode and requires Resend email delivery.
OTP_DEV_MODE=true
OTP_TTL_MS=600000
OTP_HASH_SECRET=change-me-otp-hash-secret
OTP_REQUEST_WINDOW_MS=900000
OTP_MAX_REQUESTS_PER_WINDOW=3
OTP_FROM_EMAIL=verify@nexbaron.com
# Optional shared-env alternatives: OTP_HASH_SECRET_DIGITAL/OTP_HASH_SECRET_PRINT,
# OTP_FROM_EMAIL_DIGITAL/OTP_FROM_EMAIL_PRINT, RESEND_API_KEY_DIGITAL/RESEND_API_KEY_PRINT
# Phone OTP fails with 503 until an SMS provider is implemented.

# Payments (Razorpay) — https://dashboard.razorpay.com
# Leave keys empty only in development to use fake orders. Production fails closed.
# Test keys start with rzp_test_, live keys with rzp_live_.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Webhooks always fail verification when RAZORPAY_WEBHOOK_SECRET is absent.

# Email (Resend) - configure independently in each brand deployment.
RESEND_API_KEY=
INVOICE_FROM_EMAIL=billing@nexbaron.com
QUOTE_FROM_EMAIL_DIGITAL=digital@nexbaron.com
QUOTE_FROM_EMAIL_PRINT=print@nexbaron.com
QUOTE_WHATSAPP_ENABLED=false
MAX_PRINT_QUANTITY=1000000
# Replace the placeholder in the invoice template with your GSTIN.
BILLING_GSTIN=BILLING_GSTIN_PLACEHOLDER
