{
  "version": 2,
  "rewrites": [
    {
      "source": "/digital/:path*",
      "destination": "https://nexbaron-api.vercel.app/api/digital/:path*"
    },
    {
      "source": "/print/:path*",
      "destination": "https://nexbaron-api-print.vercel.app/api/print/:path*"
    },
    {
      "source": "/api/digital/:path*",
      "destination": "https://nexbaron-api.vercel.app/api/digital/:path*"
    },
    {
      "source": "/api/print/:path*",
      "destination": "https://nexbaron-api-print.vercel.app/api/print/:path*"
    },
    {
      "source": "/health/digital",
      "destination": "https://nexbaron-api.vercel.app/health"
    },
    {
      "source": "/health/print",
      "destination": "https://nexbaron-api-print.vercel.app/health"
    }
  ]
}
